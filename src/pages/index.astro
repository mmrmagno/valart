---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import ArtCard from '@/components/ArtCard.astro';

const entries = (await getCollection('gallery')).sort(
  (a, b) => b.data.submittedAt.getTime() - a.data.submittedAt.getTime() || a.data.name.localeCompare(b.data.name),
);
const featured = entries[0];
const artists = new Set(entries.map((e) => e.data.author)).size;
---

<Base>
  <section class="hero">
    <div class="pitch">
      <p class="label">Valorant chat art</p>
      <h1>Draw it.<br />Copy it.<br /><span>Flex it.</span></h1>
      <p class="lead">A grid sized exactly for the Valorant chat box. Draw, copy in one click, paste in game. Proud of it? Send it to the gallery, no account needed.</p>
      <div class="cta">
        <a class="btn" href="/create">Start drawing</a>
        <a class="btn ghost" href="#gallery">Browse gallery</a>
      </div>
      <dl class="facts">
        <div><dt>Pieces</dt><dd>{entries.length}</dd></div>
        <div><dt>Artists</dt><dd>{artists}</dd></div>
        <div><dt>Grid</dt><dd>26×13</dd></div>
      </dl>
    </div>
    {
      featured && (
        <a class="screen" href={`/art/${featured.id}`} aria-label={`Latest: ${featured.data.name} by ${featured.data.author}`}>
          <span class="bar">
            <span>Latest</span>
            <span>{featured.data.name} · {featured.data.author}</span>
          </span>
          <span class="viewport"><pre class="art">{featured.data.art}</pre></span>
          <span class="corner tl" />
          <span class="corner br" />
        </a>
      )
    }
  </section>

  <section id="gallery" aria-labelledby="gallery-title">
    <div class="head">
      <h2 id="gallery-title">Gallery</h2>
      <span class="label">{entries.length} pieces</span>
    </div>
    {
      entries.length ? (
        <div class="grid">
          {entries.map((entry) => (
            <ArtCard entry={entry} />
          ))}
        </div>
      ) : (
        <p class="empty">Nothing here yet. Be the first: draw something and submit it.</p>
      )
    }
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: center;
    padding: 2rem 0 4rem;
  }
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }
  }
  h1 {
    font-size: clamp(2.6rem, 8vw, 5.5rem);
    margin: 0.75rem 0 1rem;
  }
  h1 span {
    color: var(--red);
  }
  .lead {
    color: var(--muted);
    font-size: 1.1rem;
    max-width: 34rem;
    margin: 0 0 1.75rem;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin: 2.25rem 0 0;
  }
  .facts div {
    border-left: 2px solid var(--red);
    padding-left: 0.75rem;
  }
  .facts dt {
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .facts dd {
    margin: 0;
    font-family: var(--display);
    font-size: 2rem;
    line-height: 1.1;
  }
  .screen {
    position: relative;
    display: block;
    background: linear-gradient(180deg, var(--surface-2), var(--surface));
    border: 1px solid var(--line);
    padding: 1.25rem 1.25rem 1.75rem;
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.2s;
  }
  .screen:hover {
    border-color: var(--red);
  }
  .bar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.75rem;
    margin-bottom: 1.5rem;
  }
  .bar span:first-child {
    color: var(--red);
    font-weight: 700;
  }
  .viewport {
    display: block;
    overflow-x: auto;
  }
  .screen .art {
    display: block;
    width: max-content;
    margin: 0 auto;
    font-size: clamp(0.8rem, 1.7vw, 1.15rem);
    text-shadow: 0 0 18px rgb(236 232 225 / 0.15);
  }
  .corner {
    position: absolute;
    width: 18px;
    height: 18px;
    border-color: var(--red);
    border-style: solid;
  }
  .corner.tl {
    top: -1px;
    left: -1px;
    border-width: 2px 0 0 2px;
  }
  .corner.br {
    bottom: -1px;
    right: -1px;
    border-width: 0 2px 2px 0;
  }
  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
    margin-bottom: 1.5rem;
  }
  .head h2 {
    font-size: 2.25rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 330px), 1fr));
    gap: 1.25rem;
  }
  .empty {
    color: var(--muted);
  }
  #gallery {
    scroll-margin-top: 5rem;
  }
</style>
